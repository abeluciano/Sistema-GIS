# Root example for local development. Copy values into local .env files only.
# Do not commit real credentials.

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL + PostGIS (Neon or compatible)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Admin dashboard auth
ADMIN_SESSION_SECRET=replace_with_a_long_random_value
JWT_ACCESS_SECRET=replace_with_a_long_random_value
BCRYPT_ROUNDS=12

# Prototype admin bootstrap. Use only in academic/local environments.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=replace_with_prototype_password
ADMIN_BOOTSTRAP_NAME=Administrador prototipo

# Firebase Admin SDK for backend token verification
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Uploads
UPLOADS_DIR=backend/uploads
MAX_REPORT_PHOTOS=3
MAX_UPLOAD_MB=5

# CORS
CORS_ORIGIN=http://localhost:5173
