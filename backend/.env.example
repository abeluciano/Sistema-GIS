NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

ADMIN_SESSION_SECRET=replace_with_a_long_random_value
JWT_ACCESS_SECRET=replace_with_a_long_random_value
BCRYPT_ROUNDS=12

# Prototype admin bootstrap. Use only in academic/local environments.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=replace_with_prototype_password
ADMIN_BOOTSTRAP_NAME=Administrador prototipo

# Required to verify Firebase ID tokens from the mobile app.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: required only when the backend needs Firebase Admin service-account permissions.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

UPLOADS_DIR=uploads
MAX_REPORT_PHOTOS=3
MAX_UPLOAD_MB=5
UPLOAD_ORPHAN_RETENTION_DAYS=7

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost,ionic://localhost,https://*.vercel.app

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

PYTHON_BIN=python
SPATIAL_PERMUTATIONS=999
