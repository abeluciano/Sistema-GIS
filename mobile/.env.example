VITE_API_BASE_URL=http://localhost:4000

# Firebase client placeholders for Ionic React.
# Keep real values only in mobile/.env.local and native Firebase files outside Git.
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_GOOGLE_WEB_CLIENT_ID=replace_with_google_web_client_id
